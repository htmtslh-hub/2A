# Bản thiết kế gốc đã giải nén ra _src/ — không cần giữ file nén 135MB
2A.zip

# Media gốc rất nặng (~130MB). Bản đã nén nằm ở web/public/media và có commit,
# nên clone về là chạy được ngay. Chỉ cần hai thư mục này khi muốn nén lại
# (`npm run media`) — lúc đó giải nén 2A.zip ra là có.
_src/uploads/
_src/assets/

# Ảnh chụp thử nghiệm trong quá trình thiết kế, không dùng đến
_src/scraps/

# Phụ thuộc và kết quả build
node_modules/
.next/
out/
build/

# Biến môi trường
.env
.env.local
.env*.local

# Hệ điều hành / trình soạn thảo
.DS_Store
Thumbs.db
*.log

# File khoá tải từ Google Cloud Console. Chứa client secret — không được
# commit. Giá trị thật nằm trong biến môi trường trên Vercel.
client_secret_*.json
*.apps.googleusercontent.com.json

# Công cụ QA và trình duyệt phục vụ quay preview, không phải mã sản phẩm
_design/.tooling/
_design/.browsers/
_design/.qa-extracted/
web/product/giao-dien-web/reviews/**/recordings/
web/product/giao-dien-web/tools/.anh-tam/

# Local reference captures/downloads; shipped sources live under web/product/.
/_design/aeris-reference/
/_design/headphone-reference/
/_design/pricing-neon-reference/
# Temporary render/QA media; retain text reports and final public previews.
/web/product/giao-dien-web/**/screenshots/
/web/product/giao-dien-web/**/recordings/
/web/product/giao-dien-web/**/design/video-analysis/
