/* TỰ ĐỘNG SINH từ thuộc tính style-hover */
.hv0:hover{ background: linear-gradient(180deg, rgba(255,255,255,.42) 0%, rgba(255,255,255,.24) 100%) !important; }
.hv1:hover{ border-color: #ffffff !important; color: #ffffff !important; }
.hv2:hover{ color: #ffffff !important; }
.hv3:hover{ background: linear-gradient(180deg, rgba(255,255,255,.40) 0%, rgba(255,255,255,.24) 100%) !important; }
.hv4:hover{ border-color: var(--acc-a50) !important; }
.hv5:hover{ border-color: #ffffff !important; color: #ffffff !important; }
.hv6:hover{ border-color: var(--acc-a55) !important; transform: translateY(-4px) !important; }
.hv7:hover{ border-color: #ffffff !important; }
.hv8:hover{ background: rgba(255,255,255,.11) !important; border-color: var(--acc-a55) !important; }
.hv9:hover{ transform: translateY(-2px) !important; }
.hv10:hover{ border-color: var(--acc-a55) !important; background: rgba(255,255,255,.05) !important; }
.hv11:hover{ background: rgba(255,255,255,.055) !important; }
.hv12:hover{ border-color: var(--hv12-border-color) !important; }
.hv13:hover{ opacity: .88 !important; }
.fc14:focus{ border-color: #ffffff !important; }
.hv15:hover{ opacity: .9 !important; }
.hv16:hover{ opacity: .75 !important; }
