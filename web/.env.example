# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã được gitignore — đừng commit khoá bí mật.

# ---------- Cơ sở dữ liệu (Neon Postgres) ----------
# Tạo project miễn phí ở https://neon.tech, copy "Connection string".
# Nhớ giữ ?sslmode=require ở cuối.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/agentic?sslmode=require"

# ---------- Auth.js ----------
# Sinh khoá ngẫu nhiên: npx auth secret
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len"

# Đăng nhập bằng Google (tuỳ chọn — bỏ trống thì nút Google tự ẩn).
# Lấy ở https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<tên-miền>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Thanh toán PayOS ----------
# Đăng ký ở https://payos.vn, lấy trong Kênh thanh toán > Thông tin kết nối.
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# ---------- Email (Resend) ----------
# https://resend.com — bỏ trống thì email chỉ ghi ra log, không gửi thật.
RESEND_API_KEY=""
MAIL_FROM="Agentic <hello@agentic.vn>"

# ---------- Địa chỉ site ----------
# Dùng để dựng returnUrl/cancelUrl của PayOS và link trong email.
# Chạy máy: http://localhost:3000 — production: https://tên-miền-thật
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
