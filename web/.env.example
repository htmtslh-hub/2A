# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã được gitignore — đừng commit khoá bí mật.

# ---------- Cơ sở dữ liệu (Neon Postgres) ----------
# Tạo project miễn phí ở https://neon.tech, copy "Connection string".
# Nhớ giữ ?sslmode=require ở cuối.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/agentic?sslmode=require"

# ---------- Auth.js ----------
# Sinh khoá ngẫu nhiên: npx auth secret
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-ky-tu-tro-len"

# Đăng nhập bằng Google (tuỳ chọn — bỏ trống thì nút Google tự ẩn).
# Lấy ở https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<tên-miền>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Thanh toán: khách Việt Nam (PayOS, thu VNĐ) ----------
# Đăng ký ở https://payos.vn, lấy trong Kênh thanh toán > Thông tin kết nối.
# Webhook trỏ về: https://<tên-miền>/api/payos/webhook
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# ---------- Thanh toán: khách quốc tế (Paddle, thu USD) ----------
# PayOS chỉ chạy trong nước (chuyển khoản ngân hàng VN, chỉ VNĐ), nên khách
# nước ngoài đi qua Paddle. Paddle đứng tên bán (merchant of record) và tự lo
# thuế VAT/GST ở từng nước, nên không cần pháp nhân nước ngoài.
#
# Lấy ở https://vendors.paddle.com > Developer Tools > Authentication.
# Khoá bắt đầu bằng 'pdl_sdbx_' sẽ tự động chạy ở môi trường sandbox.
PADDLE_API_KEY=""
# Client-side token, KHÁC api key — dùng ở phía trình duyệt nên công khai được.
# Cùng chỗ: Developer Tools > Authentication > tab Client-side tokens.
# Token sandbox bắt đầu bằng 'test_' và tự chuyển trang sang môi trường sandbox.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Developer Tools > Notifications: tạo endpoint trỏ về
# https://<tên-miền>/api/paddle/webhook rồi copy secret key ở đây.
PADDLE_WEBHOOK_SECRET=""
# Tuỳ chọn: id sản phẩm có sẵn trong catalog Paddle (pro_...). Bỏ trống thì
# mỗi đơn tự khai giá riêng, không cần dựng catalog.
PADDLE_PRODUCT_ID=""
#
# BẮT BUỘC làm trong dashboard, nếu không API từ chối tạo đơn:
# Paddle > Checkout > Checkout settings > Default payment link, điền
#   https://<tên-miền>/thanh-toan/paddle
# Paddle không có trang thanh toán host sẵn — trang đó là của mình, nhúng
# Paddle.js, và Paddle.js tự mở hộp thanh toán khi thấy tham số ?_ptxn=

# ---------- Email (Resend) ----------
# https://resend.com — bỏ trống thì email chỉ ghi ra log, không gửi thật.
RESEND_API_KEY=""
MAIL_FROM="Agentic <hello@agentic.vn>"

# ---------- Địa chỉ site ----------
# Dùng để dựng returnUrl/cancelUrl của PayOS và link trong email.
# Chạy máy: http://localhost:3000 — production: https://tên-miền-thật
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
