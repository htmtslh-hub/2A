# Biến môi trường phải khai báo trong phần Environment Variables của Vercel,
# không đi kèm mã nguồn. Không có dòng này thì `vercel deploy` tải cả .env lên.
.env
.env.*
!.env.example

# Tài sản thử nghiệm của hướng homepage cũ; sản phẩm thương mại dùng
# public/previews và public/demos/astra-interior.
public/cinematic/
# Chỉ ZIP trong product cần hiện diện ở môi trường chạy để /api/download đọc.
product/giao-dien-web/*/source/
product/giao-dien-web/docs/
product/giao-dien-web/tools/
product/giao-dien-web/*/reviews/
product/giao-dien-web/reviews/
product/giao-dien-web/*/design/
product/giao-dien-web/design/

# Retired templates are internal backups, never delivery assets.
product/retired/

# Crimson Folio is a public demo pending commercial package approval.
product/giao-dien-web/crimson-folio/scratch/
product/giao-dien-web/crimson-folio/crimson-folio.zip
